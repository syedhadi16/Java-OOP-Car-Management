import java.util.Scanner;

public class Car {

    private String brand;
    private String model;
    private int year;
    private String color;
    private double mileage;
    private double fuelLevel;
    private boolean engineOn;

    // Default constructor
    public Car() {
        brand = "Unknown";
        model = "Unknown";
        year = 0;
        color = "Unknown";
        mileage = 0;
        fuelLevel = 0;
        engineOn = false;
    }

    // Parameterized constructor
    public Car(String brand, String model, int year, String color,
               double mileage, double fuelLevel, boolean engineOn) {
        this.brand = brand;
        this.model = model;
        this.year = year;
        this.color = color;
        this.mileage = mileage;
        this.fuelLevel = fuelLevel;
        this.engineOn = engineOn;
    }

    // Getters
    public String getBrand() {
        return brand;
    }

    public String getModel() {
        return model;
    }

    public int getYear() {
        return year;
    }

    public String getColor() {
        return color;
    }

    public double getMileage() {
        return mileage;
    }

    public double getFuelLevel() {
        return fuelLevel;
    }

    public boolean isEngineOn() {
        return engineOn;
    }

    // Setters
    public void setBrand(String brand) {
        this.brand = brand;
    }

    public void setModel(String model) {
        this.model = model;
    }

    public void setYear(int year) {
        this.year = year;
    }

    public void setColor(String color) {
        this.color = color;
    }

    public void setMileage(double mileage) {
        this.mileage = mileage;
    }

    public void setFuelLevel(double fuelLevel) {
        this.fuelLevel = fuelLevel;
    }

    public void setEngineOn(boolean engineOn) {
        this.engineOn = engineOn;
    }

    // Start engine
    public void startEngine() {
        if (!engineOn) {
            engineOn = true;
            System.out.println("The engine has started.");
        } else {
            System.out.println("The engine is already running.");
        }
    }

    // Stop engine
    public void stopEngine() {
        if (engineOn) {
            engineOn = false;
            System.out.println("The engine has stopped.");
        } else {
            System.out.println("The engine is already off.");
        }
    }

    // Drive the car
    public void drive(double distance) {
        if (distance <= 0) {
            System.out.println("Distance must be more than 0.");
        } else if (!engineOn) {
            System.out.println("Start the engine first.");
        } else if (fuelLevel <= 0) {
            System.out.println("No fuel left.");
        } else {
            double fuelNeeded = distance * 0.08;

            if (fuelNeeded > fuelLevel) {
                double possibleDistance = fuelLevel / 0.08;

                mileage = mileage + possibleDistance;
                fuelLevel = 0;

                System.out.println("The car ran out of fuel.");
            } else {
                mileage = mileage + distance;
                fuelLevel = fuelLevel - fuelNeeded;

                System.out.println("The car drove " + distance + " km.");
            }
        }
    }

    // Refuel the car
    public void refuel(double amount) {
        if (amount <= 0) {
            System.out.println("Fuel amount must be more than 0.");
        } else {
            fuelLevel = fuelLevel + amount;

            if (fuelLevel > 100) {
                fuelLevel = 100;
            }

            System.out.println("Fuel level: " + fuelLevel + "%");
        }
    }

    // Show car information
    public void displayInfo() {
        System.out.println("\n--- Car Information ---");
        System.out.println("Brand: " + brand);
        System.out.println("Model: " + model);
        System.out.println("Year: " + year);
        System.out.println("Color: " + color);
        System.out.println("Mileage: " + mileage + " km");
        System.out.println("Fuel Level: " + fuelLevel + "%");
        System.out.println("Engine On: " + engineOn);
    }

    // =====================================
    // DERIVED CLASS 1: ELECTRIC CAR
    // =====================================
    static class ElectricCar extends Car {

        private double batteryLevel;

        public ElectricCar(String brand, String model, int year,
                           String color, double mileage,
                           double batteryLevel) {
            super(brand, model, year, color, mileage, 0, false);
            this.batteryLevel = batteryLevel;
        }

        public double getBatteryLevel() {
            return batteryLevel;
        }

        public void setBatteryLevel(double batteryLevel) {
            this.batteryLevel = batteryLevel;
        }

        public void chargeBattery(double amount) {
            if (amount > 0) {
                batteryLevel += amount;

                if (batteryLevel > 100) {
                    batteryLevel = 100;
                }

                System.out.println("Battery level: " + batteryLevel + "%");
            } else {
                System.out.println("Invalid charging amount.");
            }
        }

        // Polymorphism: Override displayInfo()
        @Override
        public void displayInfo() {
            System.out.println("\n--- Electric Car Information ---");
            super.displayInfo();
            System.out.println("Battery Level: " + batteryLevel + "%");
        }
    }

    // =====================================
    // DERIVED CLASS 2: SPORTS CAR
    // =====================================
    static class SportsCar extends Car {

        private boolean turboEnabled;

        public SportsCar(String brand, String model, int year,
                         String color, double mileage,
                         double fuelLevel, boolean turboEnabled) {
            super(brand, model, year, color, mileage, fuelLevel, false);
            this.turboEnabled = turboEnabled;
        }

        public boolean isTurboEnabled() {
            return turboEnabled;
        }

        public void setTurboEnabled(boolean turboEnabled) {
            this.turboEnabled = turboEnabled;
        }

        public void activateTurbo() {
            turboEnabled = true;
            System.out.println("Sports car turbo is activated.");
        }

        // Polymorphism: Override displayInfo()
        @Override
        public void displayInfo() {
            System.out.println("\n--- Sports Car Information ---");
            super.displayInfo();
            System.out.println("Turbo Enabled: " + turboEnabled);
        }
    }

    // =====================================
    // ADDITIONAL CLASS 1: CUSTOMER
    // =====================================
    static class Customer {

        private String customerName;
        private String phoneNumber;

        public Customer(String customerName, String phoneNumber) {
            this.customerName = customerName;
            this.phoneNumber = phoneNumber;
        }

        public String getCustomerName() {
            return customerName;
        }

        public String getPhoneNumber() {
            return phoneNumber;
        }

        public void displayCustomer() {
            System.out.println("\n--- Customer Information ---");
            System.out.println("Name: " + customerName);
            System.out.println("Phone: " + phoneNumber);
        }
    }

    // =====================================
    // ADDITIONAL CLASS 2: BOOKING
    // =====================================
    static class Booking {

        private String bookingID;
        private String carModel;
        private int rentalDays;

        public Booking(String bookingID, String carModel, int rentalDays) {
            this.bookingID = bookingID;
            this.carModel = carModel;
            this.rentalDays = rentalDays;
        }

        public void displayBooking() {
            System.out.println("\n--- Booking Information ---");
            System.out.println("Booking ID: " + bookingID);
            System.out.println("Car Model: " + carModel);
            System.out.println("Rental Days: " + rentalDays);
        }
    }

    // =====================================
    // ADDITIONAL CLASS 3: PAYMENT
    // =====================================
    static class Payment {

        private double amount;
        private String paymentMethod;

        public Payment(double amount, String paymentMethod) {
            this.amount = amount;
            this.paymentMethod = paymentMethod;
        }

        public void displayPayment() {
            System.out.println("\n--- Payment Information ---");
            System.out.println("Amount: RM" + amount);
            System.out.println("Payment Method: " + paymentMethod);
        }
    }

    // =====================================
    // MAIN CLASS / MAIN METHOD
    // =====================================
    public static void main(String[] args) {

        Scanner scanner = new Scanner(System.in);

        System.out.println("Choose a car:");
        System.out.println("1. Proton Saga");
        System.out.println("2. Perodua Myvi");
        System.out.print("Enter choice: ");

        int choice = scanner.nextInt();

        Car car;

        if (choice == 1) {
            car = new Car(
                "Proton", "Saga", 2022, "White", 0, 100, false
            );

        } else if (choice == 2) {
            car = new Car(
                "Perodua", "Myvi", 2022, "Red", 0, 100, false
            );

        } else {
            System.out.println("Invalid choice.");
            scanner.close();
            return;
        }

        car.displayInfo();

        System.out.println(
            "\nSelected car: " + car.getBrand() + " " + car.getModel()
        );

        // Setter example
        car.setColor("Black");
        System.out.println("New color: " + car.getColor());

        System.out.print("\nStart engine? 1 = Yes, 0 = No: ");
        int start = scanner.nextInt();

        if (start == 1) {

            car.startEngine();

            for (int i = 1; i <= 3; i++) {
                System.out.print("Enter distance to drive: ");
                double distance = scanner.nextDouble();

                car.drive(distance);
            }

            System.out.print("Enter fuel amount to add: ");
            double fuel = scanner.nextDouble();

            car.refuel(fuel);

        } else {
            System.out.println("Engine remains off.");
        }

        car.displayInfo();
        car.stopEngine();

        // Demonstrate inheritance and polymorphism
        System.out.println("\n===== OOP ASSIGNMENT 2 =====");

        Car[] vehicles = {
            new ElectricCar("Tesla", "Model 3", 2025,
                            "White", 1000, 90),

            new SportsCar("Porsche", "911", 2025,
                          "Black", 500, 80, false)
        };

        // Loop and polymorphism
        for (Car vehicle : vehicles) {
            vehicle.displayInfo();
        }

        // Demonstrate additional classes
        Customer customer = new Customer(
            "Ali", "0123456789"
        );

        Booking booking = new Booking(
            "B001", "Tesla Model 3", 3
        );

        Payment payment = new Payment(
            450.00, "Online Banking"
        );

        customer.displayCustomer();
        booking.displayBooking();
        payment.displayPayment();

        // Demonstrate additional methods
        ElectricCar electricCar =
            (ElectricCar) vehicles[0];

        electricCar.chargeBattery(10);

        SportsCar sportsCar =
            (SportsCar) vehicles[1];

        sportsCar.activateTurbo();

        scanner.close();
    }
}
